{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile pack: tiers.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tiers"
  ],
  "properties": {
    "tiers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "universal",
          "label",
          "criteria"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "universal": {
            "enum": [
              "Learned",
              "Applied",
              "Delivered",
              "Proven",
              "Sustained",
              "Recognised"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "string",
            "minLength": 1
          },
          "computed": {
            "type": "object",
            "additionalProperties": false,
            "description": "Makes this the top tier, worked out in code from the evidence, never by the AI judge (ASK-57).",
            "required": [
              "min_projects",
              "min_months"
            ],
            "properties": {
              "min_projects": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "min_months": {
                "type": "integer",
                "minimum": 0,
                "maximum": 120
              },
              "or_third_party": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
