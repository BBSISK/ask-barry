{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile pack: curve.yaml (optional)",
  "description": "The evidence curve on /curve: two climbs of skills, bottom to top. Tiers and evidence come from capability.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "climbs", "dip", "bridge"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "intro": {"type": "string", "maxLength": 300},
    "climbs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "skills"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 40},
          "note": {"type": "string", "maxLength": 120},
          "skills": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
          }
        }
      }
    },
    "dip": {"type": "string", "minLength": 1, "maxLength": 40},
    "bridge": {"type": "string", "minLength": 1, "maxLength": 40},
    "credit": {"type": "string", "maxLength": 160}
  }
}
