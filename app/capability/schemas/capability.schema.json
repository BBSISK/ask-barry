{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capability.json (output, v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "person",
    "generated_at",
    "tiers",
    "skills",
    "cards"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,60}$"
    },
    "person": {
      "type": "object",
      "required": [
        "name",
        "short_name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "short_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object"
    },
    "tiers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "level",
          "universal",
          "label"
        ],
        "properties": {
          "level": {
            "type": "integer"
          },
          "universal": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "tier",
          "evidence",
          "projects_by_tier",
          "first_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,60}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "esco_uri": {
            "type": "string"
          },
          "match": {
            "type": "array"
          },
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "first_evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "projects_by_tier": {
            "type": "object"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tier",
                "repo",
                "path",
                "heading",
                "url",
                "quote",
                "source_type",
                "verified_by"
              ],
              "properties": {
                "tier": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "repo": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "heading": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "project": {
                  "type": "string"
                },
                "source_type": {
                  "enum": [
                    "github_readme"
                  ]
                },
                "verified_by": {
                  "enum": [
                    "self",
                    "third_party"
                  ]
                },
                "first_committed": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "stories",
          "gap"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,60}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "gap": {
            "type": "boolean"
          },
          "gap_note": {
            "type": "string"
          },
          "stories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "summary",
                "repo",
                "path",
                "heading",
                "url",
                "quote",
                "source_type",
                "verified_by"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "repo": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "heading": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "project": {
                  "type": "string"
                },
                "source_type": {
                  "enum": [
                    "github_readme"
                  ]
                },
                "verified_by": {
                  "enum": [
                    "self",
                    "third_party"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
