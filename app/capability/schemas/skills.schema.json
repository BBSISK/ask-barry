{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile pack: skills.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skills"
  ],
  "properties": {
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "queries"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,60}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "match": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "esco_uri": {
            "type": "string",
            "pattern": "^http://data\\.europa\\.eu/esco/skill/"
          }
        }
      }
    }
  }
}
