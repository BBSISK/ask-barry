{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile pack: profile.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "person"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,60}$"
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "short_name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "short_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "github_owner": {
      "type": "string",
      "minLength": 1
    },
    "self_description_repos": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z-]{0,30}$"
              }
            }
          }
        ]
      }
    },
    "planned_headings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "project_kinds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "max_tier"
        ],
        "properties": {
          "max_tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "counts_for_depth": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z-]{0,30}$"
      }
    },
    "default_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z-]{0,30}$"
    }
  }
}
