{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile pack: profile.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "person"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,60}$"
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "short_name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "short_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "github_owner": {
      "type": "string",
      "minLength": 1
    },
    "self_description_repos": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
