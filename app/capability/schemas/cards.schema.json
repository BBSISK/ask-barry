{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile pack: cards.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cards"
  ],
  "properties": {
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "queries"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,60}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gap_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
