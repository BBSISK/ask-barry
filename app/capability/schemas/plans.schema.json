{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile pack: plans.yaml (optional)",
  "description": "Gap-closing plans shown beside gaps on the capability page. A plan never fills a tier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plans"
  ],
  "properties": {
    "plans": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "work",
          "planned",
          "target"
        ],
        "oneOf": [
          {
            "required": [
              "skill",
              "target_tier"
            ],
            "not": {
              "required": [
                "card"
              ]
            }
          },
          {
            "required": [
              "card"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "skill"
                  ]
                },
                {
                  "required": [
                    "target_tier"
                  ]
                }
              ]
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,60}$"
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "card": {
            "type": "string",
            "minLength": 1
          },
          "work": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "target_tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "planned": {
            "type": "string",
            "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
          },
          "target": {
            "type": "string",
            "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
          }
        }
      }
    }
  }
}
