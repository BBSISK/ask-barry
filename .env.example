# Copy to .env for local development. .env is gitignored; never commit real values.
APP_ENV=development
SECRET_KEY=change-me-locally

# Optional, read-only; raises GitHub API rate limits for scripts.fetch_docs
# GITHUB_TOKEN=

# Stage 3: Azure (see docs/azure-setup.md)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=ask-barry-chunks
